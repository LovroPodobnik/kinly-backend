{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false
    },
    "db:push": {
      "dependsOn": ["@my-app/db#build"]
    },
    "db:generate": {
      "dependsOn": ["@my-app/db#build"]
    }
  }
}
