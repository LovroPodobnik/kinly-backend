{
  "name": "@kinly/trpc-types",
  "version": "0.1.0",
  "description": "Shared tRPC types for frontend/backend type safety",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "dev": "tsc --emitDeclarationOnly --declaration --declarationMap --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@trpc/server": "^11.0.0"
  },
  "devDependencies": {
    "@trpc/server": "^11.0.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.0.0"
  }
}
